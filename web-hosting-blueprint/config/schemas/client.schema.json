{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebHostingClientConfig",
  "type": "object",
  "required": ["client", "application", "environment", "hosting", "frontend", "backend", "database", "redis", "domains", "ssl", "deployment"],
  "properties": {
    "client": {
      "type": "object",
      "required": ["name", "id"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "environment": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "type": { "enum": ["development", "staging", "production"] }
      }
    },
    "hosting": {
      "type": "object",
      "required": ["profile"],
      "properties": {
        "profile": { "enum": ["small", "standard", "resilient"] }
      }
    },
    "frontend": {
      "type": "object",
      "required": ["enabled", "framework"],
      "properties": {
        "enabled": { "type": "boolean" },
        "framework": { "enum": ["static", "react", "vue", "nextjs", "none"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "backend": {
      "type": "object",
      "required": ["enabled", "framework"],
      "properties": {
        "enabled": { "type": "boolean" },
        "framework": { "enum": ["node", "python", "go", "php", "none"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "database": {
      "type": "object",
      "required": ["enabled", "engine"],
      "properties": {
        "enabled": { "type": "boolean" },
        "engine": { "enum": ["postgresql", "none", "null"] }
      }
    },
    "redis": {
      "type": "object",
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "deployment": {
      "type": "object",
      "required": ["strategy"],
      "properties": {
        "strategy": { "enum": ["rolling", "blue-green"] }
      }
    }
  }
}
