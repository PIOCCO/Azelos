# PostgreSQL — client-provided instance (Azure, on-prem, RDS, etc.)
# Local Docker Compose (see docker-compose.yml): host port 5433, user/password dora
DATABASE_URL=postgresql+psycopg://dora:dora@127.0.0.1:5433/dora_supplier_risk

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# DB_SSL_MODE=require

# Evidence object storage (metadata remains in PostgreSQL)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage

JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Future (not required for local dev):
# STORAGE_PROVIDER=azure_blob
# AZURE_STORAGE_ACCOUNT=
# AZURE_STORAGE_CONTAINER=
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=
# STORAGE_PROVIDER=s3_compatible
# S3_ENDPOINT=
