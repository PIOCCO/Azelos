project_name    = "dora-bp"
location        = "westeurope"
owner           = "your-team"
# Use MCR until Entra allows ACR tokens (AADSTS500014); switch to *.azurecr.io after tenant/ACR auth works.
container_image = "mcr.microsoft.com/azuredocs/containerapps-helloworld:latest"
cors_origins    = "https://your-app.azurecontainerapps.io"

# Optional: your public IP for Key Vault access during first deploy
# key_vault_allowed_ip_ranges = ["203.0.113.10/32"]
