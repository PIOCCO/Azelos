# Optional: force a fixed subpath (must end with /). If unset, default build uses
# relative assets (./) and auto-detects /apio, /AIPO, or /APIO in the URL.
# VITE_BASE_PATH=/apio/
# VITE_BASE_PATH=/AIPO/

# Optional: absolute API origin if /api is not on the same host as the static files
# VITE_API_URL=https://api.example.com

# Google Sign-In button on client login/register (public client ID — not the secret)
# Same value as GOOGLE_CLIENT_ID on the backend. Required for the button on static-only hosts.
VITE_GOOGLE_CLIENT_ID=
