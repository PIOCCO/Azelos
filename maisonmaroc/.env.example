# Optional: force a fixed subpath (must end with /). If unset, default build uses
# relative assets (./) and auto-detects /apio, /AIPO, or /APIO in the URL.
# VITE_BASE_PATH=/apio/
# VITE_BASE_PATH=/AIPO/

# Optional: absolute API origin (only if API is NOT under {basename}/api on the same host).
# On dribex.ma/APIO leave unset — requests go to /APIO/api/… via reverse proxy.
# VITE_API_URL=https://dribex.ma/APIO

# Production canonical URL for SEO (sitemap, Open Graph).
# VITE_CANONICAL_ORIGIN=https://dribex.ma/APIO

# Google Sign-In button on client login/register (public client ID — not the secret)
# Same value as GOOGLE_CLIENT_ID on the backend. Required for the button on static-only hosts.
VITE_GOOGLE_CLIENT_ID=
