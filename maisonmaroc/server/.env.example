# Server
PORT=3001
NODE_ENV=development

# Allowed browser origins for CORS (comma-separated). Prefer ALLOWED_ORIGINS in production.
# LAN / Tailscale: add your URL, e.g. http://100.80.43.124:5173 — or rely on dev LAN auto-allow (non-production).
ALLOWED_ORIGINS=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Production Host header allowlist (comma-separated; ALLOWED_ORIGINS hostnames are merged automatically)
# TRUSTED_HOSTS=dribex.ma,www.dribex.ma

# JWT (use a long random string in production)
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_EXPIRES_IN=7d

# Bootstrap super-admin (created once if no SUPER_ADMIN exists)
SUPER_ADMIN_EMAIL=admin@apio.ma
SUPER_ADMIN_PASSWORD=change-me-on-first-login
SUPER_ADMIN_NAME=Super Admin

# Google OAuth — CLIENT accounts only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Public SPA URL including base path (production: https://dribex.ma/APIO)
FRONTEND_URL=http://localhost:5173

# Email (required in production for verification & password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=APIO
EMAIL_VERIFY_TTL_HOURS=48
PASSWORD_RESET_TTL_HOURS=2
AUTH_EMAIL_RATE_MAX=10
AUTH_TOKEN_MAX_ATTEMPTS=5
# Local automated tests only (never in production):
# SMTP_TEST_MODE=capture

# Cookie settings (production: Secure=true, SameSite=lax or strict)
# Production: set NODE_ENV=production and COOKIE_SECURE=true (or rely on auto Secure in production)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Document uploads (PDF/images)
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=10485760

# Production: exit on weak config unless explicitly disabled
STRICT_CONFIG=true
