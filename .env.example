# Copy to .env and fill in. Never commit .env to Git.

# Azure authentication (prefer federated OIDC in CI; use SP locally if required)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=  # Avoid when possible; use az login or OIDC

# Blueprint paths
BCBP_ROOT=/workspace
BCBP_CLIENT_CONFIG=client.yaml
BCBP_ENV=dev

# Optional overrides
BCBP_DRY_RUN=false
BCBP_LOG_DIR=reports/logs
